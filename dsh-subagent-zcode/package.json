{
  "name": "@local/dsh-subagent-zcode",
  "version": "1.0.0",
  "private": true,
  "description": "One-shot ZCode CLI subagent provider for the DeepSeek Harness delegation seam",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "bin/zcode-cli.cjs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "icon": "./icon.svg",
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
