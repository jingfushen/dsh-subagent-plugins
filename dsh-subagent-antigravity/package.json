{
  "name": "@local/dsh-subagent-antigravity",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "One-shot Antigravity CLI (agy) subagent provider for DeepSeek Harness, forced through the declared global proxy.",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "icon": "./icon.svg"
}
